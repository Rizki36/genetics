<section id="faq" class="py-24">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <p class="text-center text-sm font-semibold uppercase tracking-[0.35em] text-ember">FAQ</p>
    <h2 class="display-font mt-3 text-center text-6xl sm:text-7xl">FREQUENTLY ASKED QUESTIONS</h2>
    <div class="mt-12 space-y-4">
      <div class="faq-item rounded-[1.75rem] border border-white/10 bg-white/5">
        <button class="faq-trigger flex w-full items-center justify-between px-6 py-5 text-left">
          <span class="text-lg font-semibold">Apakah Genetics cocok untuk pemula?</span>
          <span class="faq-icon text-2xl text-ember">+</span>
        </button>
        <div class="faq-content hidden px-6 pb-6 text-white/65"> Ya. Kami punya pace group dan struktur latihan yang disesuaikan dari level beginner sampai performance runner. </div>
      </div>
      <div class="faq-item rounded-[1.75rem] border border-white/10 bg-white/5">
        <button class="faq-trigger flex w-full items-center justify-between px-6 py-5 text-left">
          <span class="text-lg font-semibold">Lokasi lari biasanya di mana?</span>
          <span class="faq-icon text-2xl text-ember">+</span>
        </button>
        <div class="faq-content hidden px-6 pb-6 text-white/65"> Mayoritas sesi di area Jombang dengan titik kumpul Jaya Raya. </div>
      </div>
      <div class="faq-item rounded-[1.75rem] border border-white/10 bg-white/5">
        <button class="faq-trigger flex w-full items-center justify-between px-6 py-5 text-left">
          <span class="text-lg font-semibold">Apa yang membedakan Genetics dari run club lain?</span>
          <span class="faq-icon text-2xl text-ember">+</span>
        </button>
        <div class="faq-content hidden px-6 pb-6 text-white/65"> Fokus kami ada pada performa, identitas visual yang kuat, dan kultur yang benar-benar menjaga solidaritas antar anggota. </div>
      </div>
    </div>
  </div>
</section>

<script>
  const faqItems = document.querySelectorAll(".faq-item");

  faqItems.forEach((item) => {
    const trigger = item.querySelector(".faq-trigger");
    const content = item.querySelector(".faq-content");
    const icon = item.querySelector(".faq-icon");

    trigger.addEventListener("click", () => {
      const isHidden = content.classList.contains("hidden");

      faqItems.forEach((otherItem) => {
        otherItem.querySelector(".faq-content").classList.add("hidden");
        otherItem.querySelector(".faq-icon").textContent = "+";
      });

      if (isHidden) {
        content.classList.remove("hidden");
        icon.textContent = "\u2212";
      }
    });
  });
</script>
