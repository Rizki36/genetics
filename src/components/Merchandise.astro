<script>
  const merchPreviewTriggers = document.querySelectorAll("[data-merch-preview]");
  const merchPreviewModal = document.getElementById("merchPreviewModal");
  const merchPreviewPanel = document.getElementById("merchPreviewPanel");
  const merchPreviewImage = document.getElementById("merchPreviewImage");
  const merchPreviewTitle = document.getElementById("merchPreviewTitle");
  const merchPreviewClosers = document.querySelectorAll("[data-close-merch-preview]");
  let merchPreviewHideTimer;

  function openMerchPreview(image, title) {
    clearTimeout(merchPreviewHideTimer);
    merchPreviewImage.style.backgroundImage = `linear-gradient(to bottom, rgba(17,17,17,0.12), rgba(17,17,17,0.38)), url('${image}')`;
    merchPreviewTitle.textContent = title;
    merchPreviewModal.hidden = false;
    merchPreviewPanel.classList.add("translate-y-6");
    merchPreviewModal.classList.remove("pointer-events-none", "opacity-0");
    merchPreviewModal.setAttribute("aria-hidden", "false");
    document.body.classList.add("modal-open");
    requestAnimationFrame(() => {
      merchPreviewPanel.classList.remove("translate-y-6");
    });
  }

  function closeMerchPreview() {
    merchPreviewModal.classList.add("pointer-events-none", "opacity-0");
    merchPreviewModal.setAttribute("aria-hidden", "true");
    merchPreviewPanel.classList.add("translate-y-6");
    document.body.classList.remove("modal-open");
    merchPreviewHideTimer = setTimeout(() => {
      if (merchPreviewModal.getAttribute("aria-hidden") === "true") {
        merchPreviewModal.hidden = true;
      }
    }, 300);
  }

  merchPreviewTriggers.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      openMerchPreview(trigger.dataset.merchPreview, trigger.dataset.merchTitle);
    });
  });

  merchPreviewClosers.forEach((closer) => {
    closer.addEventListener("click", closeMerchPreview);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && !merchPreviewModal.classList.contains("pointer-events-none")) {
      closeMerchPreview();
    }
  });
</script>
