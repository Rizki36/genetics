---
import "../styles/global.css";
---

<!doctype html>
<html lang="id">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Genetics Run Club</title>
        <meta
            name="description"
            content="Genetics Run Club adalah komunitas lari yang fokus pada routine run, event komunitas, segmen Strava, dan culture lari urban yang konsisten dan sosial."
        />
        <meta name="robots" content="index, follow" />
        <meta
            name="keywords"
            content="Genetics Run Club, komunitas lari, running club, Strava segments, routine run, event lari"
        />
        <meta name="author" content="Genetics Run Club" />
        <meta name="theme-color" content="#111111" />
        <meta
            name="google-site-verification"
            content="BZwNNXr6iJD-tDVhNdGsoqt5sugHAWg0Te2_QOBk5Rc"
        />
        <meta property="og:locale" content="id_ID" />
        <meta property="og:type" content="website" />
        <meta property="og:title" content="Genetics Run Club" />
        <meta
            property="og:description"
            content="Komunitas lari Genetics dengan routine run mingguan, event, segmen Strava, dan culture lari urban."
        />
        <meta property="og:site_name" content="Genetics Run Club" />
        <meta
            property="og:image"
            content="https://images.unsplash.com/photo-1718248028293-934f04a578db?auto=format&fit=crop&w=1600&q=80"
        />
        <meta
            property="og:image:alt"
            content="Pelari Genetics Run Club di suasana urban malam hari"
        />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content="Genetics Run Club" />
        <meta
            name="twitter:description"
            content="Routine run, event komunitas, dan segmen Strava untuk pelari yang ingin konsisten bareng crew Genetics."
        />
        <meta
            name="twitter:image"
            content="https://images.unsplash.com/photo-1718248028293-934f04a578db?auto=format&fit=crop&w=1600&q=80"
        />
        <link
            rel="icon"
            type="image/svg+xml"
            href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%23111111'/%3E%3Ctext x='50%25' y='53%25' text-anchor='middle' dominant-baseline='middle' font-family='Teko%2C%20sans-serif' font-size='42' font-weight='700' fill='%2322C55E'%3EG%3C/text%3E%3C/svg%3E"
        />
        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "SportsOrganization",
                "name": "Genetics Run Club",
                "description": "Komunitas lari Genetics yang mengadakan routine run, event komunitas, dan tantangan segmen Strava.",
                "sport": "Running",
                "image": "https://images.unsplash.com/photo-1718248028293-934f04a578db?auto=format&fit=crop&w=1600&q=80",
                "inLanguage": "id-ID"
            }
        </script>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Teko:wght@500;600;700&display=swap"
            rel="stylesheet"
        />
    </head>
    <body class="bg-coal text-white selection:bg-ember selection:text-white">
        <div class="fixed inset-0 -z-10 bg-noise opacity-80"></div>
        <div class="fixed inset-0 -z-10 grid-fade opacity-30"></div>
        <slot />
    </body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
    }
</style>
