---
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import RoutineRun from "../components/RoutineRun.astro";
import StravaSegments from "../components/StravaSegments.astro";
import Events from "../components/Events.astro";
import NextEvent from "../components/NextEvent.astro";
import Merchandise from "../components/Merchandise.astro";
import FAQ from "../components/FAQ.astro";
import Socials from "../components/Socials.astro";
import Footer from "../components/Footer.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <Header />
    <main id="home">
        <Hero />
        <RoutineRun />
        <StravaSegments />
        <Events />
        <NextEvent />
        <Merchandise />
        <FAQ />
        <Socials />
    </main>
    <Footer />
</Layout>
